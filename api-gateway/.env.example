# API Gateway Environment Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to git!

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
# Must be at least 32 characters long
# IMPORTANT: Must match jwt.secret in Auth Service (application.properties)
JWT_SECRET=caef38e2f3667de7631b24840629c0aa60ef53f76a7c3e66d5edd0218a2df52c

# Backend Services URLs
# These names must match what api-gateway/server.js reads
BACKEND_URL=http://localhost:8080
PRODUCT_SERVICE_URL=http://localhost:8081
ORDER_SERVICE_URL=http://localhost:8091
AUDIT_SERVICE_URL=http://localhost:8082

# Legacy names from older gateway versions (kept for reference only)
# BACKEND_URL_AUTH=http://localhost:8001
# BACKEND_URL_PRODUCT=http://localhost:8003
# BACKEND_URL_ORDER=http://localhost:8002
# BACKEND_URL_AUDIT=http://localhost:8004

# CORS Configuration
# Comma-separated list of allowed origins
# Frontend URLs that are allowed to call this gateway
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Logging
LOG_LEVEL=debug

# Request Timeout (milliseconds)
REQUEST_TIMEOUT=30000

# Allowed Methods
ALLOWED_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE

# Database for session storage (optional)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Security
# Encryption key for sensitive data (optional)
# ENCRYPTION_KEY=your_encryption_key_here
