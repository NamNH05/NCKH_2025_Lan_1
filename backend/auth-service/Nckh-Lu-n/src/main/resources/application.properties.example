# Auth Service Configuration
# Copy this file to src/main/resources/application.properties
# Adjust values for your environment (local, dev, production)

# ============================================
# SERVER CONFIGURATION
# ============================================
server.port=8001
server.address=0.0.0.0
server.servlet.context-path=/

# Application Name
spring.application.name=auth-service

# ============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================

# Database Connection
# Format: jdbc:postgresql://host:port/database
spring.datasource.url=jdbc:postgresql://localhost:5432/nckh_auth?timezone=Asia/Ho_Chi_Minh
spring.datasource.username=auth_user
spring.datasource.password=auth@123456
spring.datasource.driver-class-name=org.postgresql.Driver

# Connection Pool Configuration
spring.datasource.hikari.maximum-pool-size=20
spring.datasource.hikari.minimum-idle=5
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.idle-timeout=600000
spring.datasource.hikari.max-lifetime=1800000

# ============================================
# JPA / HIBERNATE CONFIGURATION
# ============================================

# Auto DDL (Data Definition Language)
# Possible values:
#   - none: do not do any updates
#   - validate: validate schema, don't make changes
#   - update: update schema if needed (DEFAULT for development)
#   - create: drop everything and create new (dangerous!)
#   - create-drop: drop on exit (for testing)
spring.jpa.hibernate.ddl-auto=update

# Hibernate Settings
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.use_sql_comments=true

# Logging SQL (set to DEBUG level)
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=DEBUG

# ============================================
# REDIS CONFIGURATION (Cache)
# ============================================

spring.data.redis.host=localhost
spring.data.redis.port=6379
spring.data.redis.password=
spring.data.redis.timeout=2000
spring.cache.type=redis

# Cache TTL (Time To Live)
spring.cache.redis.time-to-live=3600000

# ============================================
# JWT CONFIGURATION
# ============================================

# JWT Secret Key
# IMPORTANT: Must be at least 32 characters
# IMPORTANT: Must match JWT_SECRET in API Gateway (.env)
jwt.secret=caef38e2f3667de7631b24840629c0aa60ef53f76a7c3e66d5edd0218a2df52c

# JWT Token Expiration (milliseconds)
# 86400000 = 24 hours
# 604800000 = 7 days
jwt.expiration=86400000

# JWT Refresh Token Expiration
jwt.refresh.expiration=604800000

# ============================================
# BOOTSTRAP ADMIN USER
# ============================================

# Default admin account (created on first startup)
# IMPORTANT: Change password in production!
bootstrap.admin.username=sysadmin
bootstrap.admin.password=1234
bootstrap.admin.email=sysadmin@system.local
bootstrap.admin.fullName=System Administrator

# ============================================
# LOGGING CONFIGURATION
# ============================================

logging.level.root=INFO
logging.level.vn.id.luannv=DEBUG
logging.level.org.springframework.web=INFO
logging.level.org.springframework.security=INFO

# Log file location
logging.file.name=logs/auth-service.log
logging.file.max-size=10MB
logging.file.max-history=10

# ============================================
# JACKSON (JSON Serialization)
# ============================================

spring.jackson.serialization.fail-on-empty-beans=false
spring.jackson.serialization.write-dates-as-timestamps=false
spring.jackson.time-zone=Asia/Ho_Chi_Minh
spring.jackson.locale=en_US

# ============================================
# CHARSET / ENCODING
# ============================================

server.servlet.encoding.charset=UTF-8
server.servlet.encoding.enabled=true
server.servlet.encoding.force=true

# ============================================
# ERROR HANDLING
# ============================================

server.error.include-message=always
server.error.include-binding-errors=always
server.error.include-stacktrace=on-param
server.error.include-exception=false

# ============================================
# ENVIRONMENT-SPECIFIC PROFILES
# ============================================
# Uncomment one of these based on your environment:

# Development
spring.profiles.active=dev

# Production (uncommit for prod deployment)
# spring.profiles.active=prod
