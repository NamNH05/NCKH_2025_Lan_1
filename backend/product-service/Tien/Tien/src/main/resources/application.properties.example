# Product Service Configuration
# Copy this file to src/main/resources/application.properties
# Adjust values for your environment (local, dev, production)

# ============================================
# SERVER CONFIGURATION
# ============================================
server.port=8003
server.address=0.0.0.0
spring.application.name=product-service

# ============================================
# DATABASE CONFIGURATION (MySQL)
# ============================================

# Database Connection
# Format: jdbc:mysql://host:port/database
spring.datasource.url=jdbc:mysql://localhost:3306/shopquanao?useSSL=false&serverTimezone=Asia/Ho_Chi_Minh&allowPublicKeyRetrieval=true
spring.datasource.username=product_user
spring.datasource.password=product@123456
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# Connection Pool Configuration
spring.datasource.hikari.maximum-pool-size=20
spring.datasource.hikari.minimum-idle=5
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.idle-timeout=600000

# ============================================
# JPA / HIBERNATE CONFIGURATION
# ============================================

spring.jpa.hibernate.ddl-auto=update
spring.jpa.database-platform=org.hibernate.dialect.MySQL8Dialect
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true

# ============================================
# LOGGING CONFIGURATION
# ============================================

logging.level.root=INFO
logging.level.com.BackEnd_Tien=DEBUG
logging.file.name=logs/product-service.log

# ============================================
# JACKSON CONFIGURATION
# ============================================

spring.jackson.time-zone=Asia/Ho_Chi_Minh
spring.jackson.serialization.write-dates-as-timestamps=false

# ============================================
# CHARSET
# ============================================

server.servlet.encoding.charset=UTF-8
server.servlet.encoding.force=true

# ============================================
# ENVIRONMENT-SPECIFIC PROFILES
# ============================================

spring.profiles.active=dev
# spring.profiles.active=prod
