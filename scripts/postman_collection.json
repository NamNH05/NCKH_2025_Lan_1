{
  "info": {
    "name": "Nckh API Tests - CSRF & JWT",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0",
    "description": "Collection to test CSRF + JWT combinations, login, register, product and audit endpoints."
  },
  "item": [
    {
      "name": "Get CSRF Token",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/csrf-token",
          "host": ["{{baseUrl}}"],
          "path": ["api","csrf-token"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "pm.test('status is 200', () => pm.expect(pm.response.code).to.equal(200));",
              "if (json && json.csrfToken) {",
              "  pm.environment.set('csrfToken', json.csrfToken);",
              "  console.log('Saved csrfToken');",
              "} else {",
              "  pm.test('csrfToken present', () => pm.expect.fail('No csrfToken in response'))",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Register - basic",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"test+{{username}}@example.com\",\n  \"fullName\": \"Test User\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": ["{{baseUrl}}"],
          "path": ["api","auth","register"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('register status 200', () => pm.expect(pm.response.code).to.equal(200));",
              "const json = pm.response.json();",
              "if (json && json.id) pm.environment.set('userId', json.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login - save JWT",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["api","auth","login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('login returns 200', () => pm.expect(pm.response.code).to.equal(200));",
              "const json = pm.response.json();",
              "if (json && json.token) {",
              "  pm.environment.set('jwtToken', json.token);",
              "  console.log('Saved jwtToken');",
              "} else {",
              "  pm.test('token present', () => pm.expect.fail('No token in login response'))",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Products - without login",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api","products"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": { "exec": [
            "pm.test('get products status 200', () => pm.expect(pm.response.code).to.equal(200));",
            "const json = pm.response.json();",
            "pm.test('response is array or object', () => pm.expect(json).to.be.ok);"] }
        }
      ]
    },
    {
      "name": "Get Products - with login",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": ["{{baseUrl}}"],
          "path": ["api","products"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": { "exec": [
            "pm.test('get products with login status 200', () => pm.expect(pm.response.code).to.equal(200));"] }
        }
      ]
    },
    {
      "name": "Create Order - both CSRF+JWT",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-CSRF-Token", "value": "{{csrfToken}}" },
          { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"cartItems\": [{\"productId\": 1, \"quantity\": 2, \"price\": 50}],\n  \"shippingFee\": 10.0,\n  \"totalAmount\": 110.0,\n  \"address\": \"123 Test Street\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/orders/checkout", "host": ["{{baseUrl}}"], "path": ["api","orders","checkout"] }
      },
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "// Ensure CSRF token exists; if not, request it",
          "if (!pm.environment.get('csrfToken')){",
          "  pm.sendRequest({url: pm.environment.get('baseUrl') + '/api/csrf-token', method: 'GET'}, function (err, res) {",
          "    if (!err && res && res.json && res.json().csrfToken) pm.environment.set('csrfToken', res.json().csrfToken);",
          "  });",
          "}"
        ] } },
        { "listen": "test", "script": { "exec": [
          "pm.test('create order (both) returns success', () => pm.expect(pm.response.code).to.be.oneOf([200,201,202]));",
          "const json = pm.response.json();",
          "if (json && json.data && json.data.id) pm.environment.set('orderId', json.data.id);"] } }
      ]
    },
    {
      "name": "Create Order - none (no CSRF, no JWT)",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{\n  \"userId\": 1,\n  \"cartItems\": [{\"productId\": 1, \"quantity\": 1}],\n  \"shippingFee\": 5.0,\n  \"totalAmount\": 55.0,\n  \"address\": \"Test Address\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/orders/checkout", "host": ["{{baseUrl}}"], "path": ["api","orders","checkout"] }
      },
      "event": [ { "listen": "test", "script": { "exec": [
        "pm.test('create order (none) should fail CSRF', () => pm.expect(pm.response.code).to.be.above(399));",
        "console.log('Response:', pm.response.text());"] } } ]
    },
    {
      "name": "Create Order - CSRF only",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-CSRF-Token", "value": "{{csrfToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"userId\": 1,\n  \"cartItems\": [{\"productId\": 2, \"quantity\": 1}],\n  \"shippingFee\": 8.0,\n  \"totalAmount\": 58.0,\n  \"address\": \"CSRF Only Address\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/orders/checkout", "host": ["{{baseUrl}}"], "path": ["api","orders","checkout"] }
      },
      "event": [ { "listen": "prerequest", "script": { "exec": [
        "if (!pm.environment.get('csrfToken')){",
        "  pm.sendRequest({url: pm.environment.get('baseUrl') + '/api/csrf-token', method: 'GET'}, function (err, res) {",
        "    if (!err && res && res.json && res.json().csrfToken) pm.environment.set('csrfToken', res.json().csrfToken);",
        "  });",
        "}"
      ] } }, { "listen": "test", "script": { "exec": [
        "pm.test('create order (csrf only) success', () => pm.expect(pm.response.code).to.be.oneOf([200,201,202]));"] } } ]
    },
    {
      "name": "Create Order - JWT only",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"userId\": 1,\n  \"cartItems\": [{\"productId\": 3, \"quantity\": 1}],\n  \"shippingFee\": 7.0,\n  \"totalAmount\": 57.0,\n  \"address\": \"JWT Only Address\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/orders/checkout", "host": ["{{baseUrl}}"], "path": ["api","orders","checkout"] }
      },
      "event": [ { "listen": "test", "script": { "exec": [
        "pm.test('create order (jwt only) should fail CSRF', () => pm.expect(pm.response.code).to.be.above(399));",
        "console.log('Response:', pm.response.text());"] } } ]
    },
    {
      "name": "Create Order - with login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-CSRF-Token", "value": "{{csrfToken}}" },
          { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"cartItems\": [{\"productId\": 4, \"quantity\": 1, \"price\": 100}],\n  \"shippingFee\": 15.0,\n  \"totalAmount\": 115.0,\n  \"address\": \"Logged In User Address\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/orders/checkout", "host": ["{{baseUrl}}"], "path": ["api","orders","checkout"] }
      },
      "event": [
        { "listen": "prerequest", "script": { "exec": [
          "if (!pm.environment.get('csrfToken')){",
          "  pm.sendRequest({url: pm.environment.get('baseUrl') + '/api/csrf-token', method: 'GET'}, function (err, res) {",
          "    if (!err && res && res.json && res.json().csrfToken) pm.environment.set('csrfToken', res.json().csrfToken);",
          "  });",
          "}"
        ] } },
        { "listen": "test", "script": { "exec": [
          "pm.test('create order (with login) success', () => pm.expect(pm.response.code).to.be.oneOf([200,201,202]));",
          "const json = pm.response.json();",
          "console.log('Order created with login:', json);"] } }
      ]
    },
    {
      "name": "Create Order - without login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": 1,\n  \"cartItems\": [{\"productId\": 5, \"quantity\": 1}],\n  \"shippingFee\": 5.0,\n  \"totalAmount\": 55.0,\n  \"address\": \"Guest Address\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/orders/checkout", "host": ["{{baseUrl}}"], "path": ["api","orders","checkout"] }
      },
      "event": [
        { "listen": "test", "script": { "exec": [
          "pm.test('create order (without login) should fail', () => pm.expect(pm.response.code).to.be.above(399));",
          "console.log('Response:', pm.response.text());"] } }
      ]
    },
    {
      "name": "Get Audit Logs - with login",
      "request": {
        "method": "GET",
        "header": [ { "key": "Authorization", "value": "Bearer {{jwtToken}}" } ],
        "url": { "raw": "{{baseUrl}}/api/v1/audits", "host": ["{{baseUrl}}"], "path": ["api","v1","audits"] }
      },
      "event": [ { "listen": "test", "script": { "exec": [
        "pm.test('get audits with login should be 200', () => pm.expect(pm.response.code).to.equal(200));"] } } ]
    },
    {
      "name": "Get Audit Logs - without login",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/v1/audits", "host": ["{{baseUrl}}"], "path": ["api","v1","audits"] }
      },
      "event": [ { "listen": "test", "script": { "exec": [
        "pm.test('get audits without login should fail', () => pm.expect(pm.response.code).to.be.above(399));"] } } ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "csrfToken", "value": "" },
    { "key": "jwtToken", "value": "" },
    { "key": "username", "value": "testuser" },
    { "key": "password", "value": "Password123!" },
    { "key": "productId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "orderId", "value": "" }
  ]
}
