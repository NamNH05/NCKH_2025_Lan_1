  "item": [
    {
      "name": "Auth Service",
      "description": "Kiểm thử Auth Service endpoints",
      "item": [
        {
          "name": "TC1 - Login Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test Case 1: Login thành công",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response body is not empty', function () {",
                  "    pm.response.to.not.be.empty;",
                  "});",
                  "",
                  "pm.test('Response has token', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.expect(jsonData.token).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test('Response has username', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('username');",
                  "    pm.expect(jsonData.username).to.not.be.empty;",
                  "});",
                  "",
                  "pm.test('Response has id', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData.id).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Response has email', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('email');",
                  "});",
                  "",
                  "pm.test('Response has role', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('role');",
                  "    pm.expect(jsonData.role).to.include('ROLE');",
                  "});",
                  "",
                  "// Save token cho requests tiếp theo",
                  "try {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.token && jsonData.username) {",
                  "        pm.environment.set('token', jsonData.token);",
                  "        pm.environment.set('username', jsonData.username);",
                  "        console.log('✅ Token saved successfully!');",
                  "        console.log('Token length: ' + jsonData.token.length);",
                  "        console.log('Username: ' + jsonData.username);",
                  "    } else {",
                  "        console.log('❌ Token save failed: Missing token or username in response');",
                  "    }",
                  "} catch(e) {",
                  "    console.log('❌ Token save failed: ' + e.message);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"john\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{auth_service_url}}/api/auth/login",
              "protocol": "http",
              "host": [
                "{{auth_service_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "✅ Test Case 1: Login thành công với đúng username/password"
          },
          "response": []
        },
