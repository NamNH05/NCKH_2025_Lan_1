        {
          "name": "TC6 - Validate Token",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Kiểm tra xem có token không",
                  "var token = pm.environment.get('token');",
                  "var username = pm.environment.get('username');",
                  "",
                  "if (!token || token === '') {",
                  "    console.log('❌ ERROR: No token found!');",
                  "    console.log('👉 Please run TC1 (Login Success) first to get a token');",
                  "    pm.execution.skipRequest();",
                  "    pm.test('⏭️  SKIPPED - Run TC1 first', function() {",
                  "        pm.expect(true).to.be.true;",
                  "    });",
                  "} else {",
                  "    console.log('✅ Token found (length: ' + token.length + ')');",
                  "    console.log('✅ Username: ' + username);",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test Case 6: Validate token",
                  "var token = pm.environment.get('token');",
                  "if (!token) {",
                  "    pm.test('❌ No token - Run TC1 first', function() {",
                  "        pm.expect(false).to.be.true;",
                  "    });",
                  "} else {",
                  "    console.log('Response Status: ' + pm.response.code);",
                  "    console.log('Response Length: ' + pm.response.length);",
                  "    console.log('Response Body: ' + pm.response.text().substring(0, 300));",
                  "    ",
                  "    pm.test('Should get 200 response', function () {",
                  "        if (pm.response.code === 500) {",
                  "            console.log('❌ 500 ERROR - Endpoint không hoạt động');",
                  "        }",
                  "        pm.expect([200, 201]).to.include(pm.response.code);",
                  "    });",
                  "    ",
                  "    pm.test('Should have response body', function () {",
                  "        pm.expect(pm.response.text()).to.not.be.empty;",
                  "    });",
                  "    ",
                  "    try {",
                  "        var jsonData = pm.response.json();",
                  "        console.log('✅ Response JSON valid');",
                  "        console.log('Response keys: ' + Object.keys(jsonData).join(', '));",
                  "        ",
                  "        pm.test('Response should have username', function () {",
                  "            pm.expect(jsonData).to.have.property('username');",
                  "            console.log('Username: ' + jsonData.username);",
                  "        });",
                  "        ",
                  "        pm.test('Response should have authorities', function () {",
                  "            pm.expect(jsonData).to.have.property('authorities');",
                  "            pm.expect(jsonData.authorities).to.be.an('array');",
                  "            console.log('Authorities: ' + JSON.stringify(jsonData.authorities));",
                  "        });",
                  "        ",
                  "        pm.test('Username should match login user', function () {",
                  "            var expectedUsername = pm.environment.get('username');",
                  "            console.log('Expected: ' + expectedUsername + ', Got: ' + jsonData.username);",
                  "            pm.expect(jsonData.username).to.equal(expectedUsername);",
                  "        });",
                  "    } catch(e) {",
                  "        console.log('❌ JSON parse error: ' + e.message);",
                  "        console.log('Response text: ' + pm.response.text());",
                  "        pm.test('Response is valid JSON', function () {",
                  "            pm.expect(false).to.be.true;",
                  "        });",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
