        {
          "name": "TC4 - Login Empty Username",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Test Case 4: Login với username trống",
                  "pm.test('Status code is 400 or 422', function () {",
                  "    pm.expect([400, 422]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('Response has error message', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('message');",
                  "    console.log('❌ Message: ' + jsonData.message);",
                  "});",
                  "",
                  "pm.test('Should reject empty username', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var message = (jsonData.message || '').toLowerCase();",
                  "    var keywords = ['required', 'empty', 'blank', 'bắt buộc', 'không được', 'validation', 'invalid', 'failed', 'username'];",
                  "    var found = keywords.some(function(k) { return message.includes(k); });",
                  "    console.log('Validation keywords found: ' + found);",
                  "    pm.expect(found || pm.response.code === 400).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
