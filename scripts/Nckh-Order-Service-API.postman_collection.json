    {
      "name": "Order Service - Unit Tests",
      "item": [
        {
          "name": "Create Order - Success",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const timestamp = new Date().toISOString();",
                  "pm.collectionVariables.set(\"requestTimestamp\", timestamp);",
                  "",
                  "console.log(\"Creating order at: \" + timestamp);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response should have order ID\", function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData.id).to.be.a('number');",
                  "    pm.collectionVariables.set(\"orderId\", jsonData.id);",
                  "});",
                  "",
                  "pm.test(\"Order status should be PENDING\", function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.equal('PENDING');",
                  "});",
                  "",
                  "pm.test(\"Total price should be calculated correctly\", function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData.totalPrice).to.equal(250.00);",
                  "});",
                  "",
                  "pm.test(\"Response should have all required fields\", function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.all.keys('id', 'items', 'totalPrice', 'status', 'createdAt');",
                  "});",
                  "",
                  "pm.test(\"Items should have correct structure\", function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData.items).to.be.an('array');",
                  "    pm.expect(jsonData.items).to.have.lengthOf(2);",
                  "    pm.expect(jsonData.items[0]).to.have.all.keys('productId', 'productName', 'price', 'quantity');",
                  "});",
                  "",
                  "pm.test(\"Response time should be less than 1000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"productName\": \"PRODUCT1\",\n      \"price\": 100.00,\n      \"quantity\": 2\n    },\n    {\n      \"productId\": 2,\n      \"productName\": \"PRODUCT2\",\n      \"price\": 50.00,\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Order - Validation Error (Empty Items)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code should be 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Error response should have error message\", function () {",
                  "    let jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('error');",
                  "    pm.expect(jsonData.error).to.include('must have at least one item');",
                  "});",
                  "",
                  "pm.test(\"Should not create order with empty items\", function () {",
                  "    pm.expect(pm.response.code).to.not.equal(201);",
                  "});"
                ],
