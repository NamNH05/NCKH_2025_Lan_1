                  "        pm.expect(product).to.have.all.keys('id', 'name', 'price', 'stock');",
                  "        pm.expect(product.price).to.be.a('number');",
                  "        pm.expect(product.price).to.be.greaterThan(0);",
                  "    });",
                  "});"
