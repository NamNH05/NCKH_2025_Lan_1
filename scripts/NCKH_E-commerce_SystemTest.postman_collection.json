                  "});",
                  "",
                  "console.log('✅ ST5.1 PASS: Invalid token properly rejected');"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer invalid.token.xyz"
              }
            ],
            "url": {
              "raw": "http://localhost:8080/api/test/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": ["8080"],
              "path": ["api", "test", "me"]
            }
          }
        },
